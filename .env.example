# ---- Studiq Server Environment ----
# Copy this file to .env and fill in real values.

# Server
PORT=5000

# MongoDB (Atlas)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/studiq
# Optional local fallback
LOCAL_MONGO_URI=mongodb://127.0.0.1:27017/studiq

# Auth
JWT_SECRET=change_this_to_a_long_random_string

# Frontend origin (CORS) — your deployed client URL
CLIENT_URL=http://localhost:5173

# Groq AI keys — primary + up to 3 fallbacks (rotates on rate limit)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY_2=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY_3=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY_4=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth (optional — for "Continue with Google" sign-in)

