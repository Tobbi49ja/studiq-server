# ---- Studiq Server Environment ----
# Copy this file to .env and fill in real values.

# Server
PORT=5000

# MongoDB (Atlas)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/studiq
# Optional local fallback
LOCAL_MONGO_URI=mongodb://127.0.0.1:27017/studiq

# Auth
JWT_SECRET=change_this_to_a_long_random_string

# Frontend origin (CORS) — your deployed client URL
CLIENT_URL=http://localhost:5173

# Groq AI keys — primary + up to 3 fallbacks.
# Rotation happens on 429 rate limit, 401/403 auth errors and 5xx/network faults.
# A 404 model_not_found or 400 invalid_request_error does NOT rotate (it would
# fail on every key) and is reported immediately.
# Leave _2.._4 unset if you only have one key — blank values are ignored.
GROQ_API_KEY=gsk_replace_me
GROQ_API_KEY_2=gsk_replace_me
GROQ_API_KEY_3=gsk_replace_me
GROQ_API_KEY_4=gsk_replace_me

# Model id used for every AI call. Must be a model your Groq account can access,
# or Groq returns 404 model_not_found. Verify with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# The server checks this at startup and warns if the id is missing.
GROQ_MODEL=qwen/qwen3.8-27b

# If GROQ_MODEL stops working, requests automatically retry once on this model
# so AI features stay up while you fix GROQ_MODEL. Rotation still applies.
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google OAuth (optional — for "Continue with Google" sign-in)

